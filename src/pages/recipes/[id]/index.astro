---
import {
  IconExternalLink,
  IconPencil,
  IconToolsKitchen2,
} from "@tabler/icons-react"

import { Badge } from "@/components/ui/badge"
import { cn } from "cn"

import { buttonVariants } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import AppLayout from "@/layouts/app.astro"
import { getDatabase } from "@/server/database"
import { getRecipe, recordView } from "@/server/library"
import { parseId } from "@/server/params"

const id = parseId(Astro.params.id)
const recipe = id && getRecipe(getDatabase(), id)
if (!recipe) return Astro.rewrite("/404")
recordView(getDatabase(), recipe.id)

const facts = [
  { label: "Serves", value: recipe.servings },
  { label: "Prep", value: recipe.prepTime },
  { label: "Cook", value: recipe.cookTime },
].filter((fact) => fact.value)
---

<AppLayout
  title={recipe.title}
  hue={recipe.sectionColor}
  activeRecipeId={recipe.id}
>
  <a
    slot="actions"
    href={`/recipes/${recipe.id}/edit`}
    class={cn(buttonVariants({ variant: "ghost" }))}
  >
    <IconPencil />
    Edit
  </a>
  <header
    slot="hero"
    class="mx-auto flex w-full max-w-5xl flex-col items-start gap-4 px-5 pt-2 pb-8 md:gap-5 md:px-10 md:pt-6 md:pb-10"
  >
    <Badge variant="secondary" className="h-7 gap-2 px-3 text-sm">
      <span class="size-2 rounded-full bg-swatch"></span>
      {recipe.sectionName}
    </Badge>
    <h1 class="type-display text-5xl leading-[0.95] text-balance md:text-7xl xl:text-8xl">
      {recipe.title}
    </h1>
    {recipe.description && (
      <p class="max-w-2xl text-lg text-muted-foreground md:text-xl">
        {recipe.description}
      </p>
    )}
    <div class="mt-2 flex w-full flex-col gap-x-8 gap-y-6 sm:w-auto sm:flex-row sm:items-center">
      {recipe.steps.length > 0 && (
        <a
          href={`/recipes/${recipe.id}/cook`}
          class={cn(
            buttonVariants({ size: "lg" }),
            "h-12 px-6 text-base max-sm:order-last"
          )}
        >
          <IconToolsKitchen2 />
          Start cooking
        </a>
      )}
      {(facts.length > 0 || recipe.sourceUrl) && (
        <dl class="flex flex-wrap items-center gap-x-5 gap-y-3">
          {facts.map(({ label, value }, index) => (
            <>
              {index > 0 && (
                <Separator
                  orientation="vertical"
                  className="h-8 max-sm:hidden"
                />
              )}
              <div class="flex flex-col">
                <dt class="text-sm text-muted-foreground">{label}</dt>
                <dd class="font-semibold">{value}</dd>
              </div>
            </>
          ))}
          {recipe.sourceUrl && (
            <>
              {facts.length > 0 && (
                <Separator
                  orientation="vertical"
                  className="h-8 max-sm:hidden"
                />
              )}
              <div class="flex flex-col">
                <dt class="text-sm text-muted-foreground">Source</dt>
                <dd>
                  <a
                    href={recipe.sourceUrl}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="inline-flex items-center gap-1 font-semibold underline-offset-4 hover:underline"
                  >
                    {new URL(recipe.sourceUrl).hostname.replace(/^www\./, "")}
                    <IconExternalLink className="size-4" />
                  </a>
                </dd>
              </div>
            </>
          )}
        </dl>
      )}
    </div>
  </header>
  <article class="@container mx-auto w-full max-w-5xl px-5 pt-6 pb-16 md:px-10 md:pt-2">
    <div class="grid items-start gap-x-12 gap-y-10 @2xl:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <section class="flex flex-col rounded-3xl bg-secondary p-6 pb-3 text-secondary-foreground">
        <h2 class="mb-2 font-semibold">Ingredients</h2>
        {recipe.ingredients.length > 0 ? (
          <ul class="divide-y divide-current/10 border-t border-current/10">
            {recipe.ingredients.map((ingredient) => (
              <li class="py-3 font-medium">{ingredient}</li>
            ))}
          </ul>
        ) : (
          <p class="pb-3">No ingredients yet.</p>
        )}
      </section>
      <section class="flex flex-col gap-4 @2xl:pt-6">
        <h2 class="font-semibold">Steps</h2>
        {recipe.steps.length > 0 ? (
          <ol class="flex max-w-prose flex-col gap-5">
            {recipe.steps.map((step, index) => (
              <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-4 text-lg">
                <span class="mt-0.5 flex size-7 items-center justify-center rounded-lg bg-secondary text-sm font-bold text-secondary-foreground tabular-nums">
                  {index + 1}
                </span>
                <span class="whitespace-pre-line">{step}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="text-muted-foreground">No steps yet.</p>
        )}
      </section>
    </div>
    {recipe.notes && (
      <section class="mt-12 flex max-w-prose flex-col gap-3 border-t pt-8">
        <h2 class="font-semibold">Notes</h2>
        <p class="text-lg whitespace-pre-line">{recipe.notes}</p>
      </section>
    )}
  </article>
</AppLayout>
