---
import { IconDownload } from "@tabler/icons-react"

import { RestoreBackup } from "@/components/restore-backup"
import { ThemeSetting } from "@/components/theme-setting"
import { cn } from "cn"

import { buttonVariants } from "@/components/ui/button"
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemGroup,
  ItemTitle,
} from "@/components/ui/item"
import AppLayout from "@/layouts/app.astro"
import { parseTheme, THEME_COOKIE } from "@/lib/theme"
import { getDatabase } from "@/server/database"
import { listSections } from "@/server/library"

const sections = listSections(getDatabase())
const recipeCount = sections.reduce((n, s) => n + s.recipes.length, 0)
const theme = parseTheme(Astro.cookies.get(THEME_COOKIE)?.value)
---

<AppLayout title="Settings">
  <div
    slot="hero"
    class="mx-auto w-full max-w-3xl px-5 pt-2 pb-8 md:px-10 md:pt-6 md:pb-10"
  >
    <h1 class="type-display text-5xl leading-none md:text-6xl">Settings</h1>
  </div>
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 pt-6 pb-16 md:px-10 md:pt-0">
    <ItemGroup>
      <Item variant="outline">
        <ItemContent className="min-w-56">
          <ItemTitle>Theme</ItemTitle>
          <ItemDescription>
            Use light or dark mode, or match this device.
          </ItemDescription>
        </ItemContent>
        <ItemActions>
          <ThemeSetting client:load theme={theme} />
        </ItemActions>
      </Item>
      <Item variant="outline">
        <ItemContent>
          <ItemTitle>Export a backup</ItemTitle>
          <ItemDescription>
            Download every section and recipe as a JSON file.
          </ItemDescription>
        </ItemContent>
        <ItemActions>
          <a
            href="/backup.json"
            download
            class={cn(buttonVariants({ variant: "secondary" }))}
          >
            <IconDownload />
            Export
          </a>
        </ItemActions>
      </Item>
      <Item variant="outline">
        <ItemContent>
          <ItemTitle>Restore a backup</ItemTitle>
          <ItemDescription>
            Replace everything with the contents of a backup file.
          </ItemDescription>
        </ItemContent>
        <ItemActions className="flex-col items-end">
          <RestoreBackup
            client:load
            sectionCount={sections.length}
            recipeCount={recipeCount}
          />
        </ItemActions>
      </Item>
    </ItemGroup>
  </div>
</AppLayout>
