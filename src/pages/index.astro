---
import { IconChefHat } from "@tabler/icons-react"

import { NewSectionButton } from "@/components/section-dialog"
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty"
import AppLayout from "@/layouts/app.astro"
import { getDatabase } from "@/server/database"
import { listSections } from "@/server/library"

const hasSections = listSections(getDatabase()).length > 0
---

<AppLayout breadcrumb={["Recipes"]}>
  <Empty className="flex-1">
    <EmptyHeader>
      <EmptyMedia variant="icon">
        <IconChefHat />
      </EmptyMedia>
      {hasSections ? (
        <>
          <EmptyTitle>Pick a recipe</EmptyTitle>
          <EmptyDescription>
            Choose a recipe from the sidebar, or add one to a section.
          </EmptyDescription>
        </>
      ) : (
        <>
          <EmptyTitle>No recipes yet</EmptyTitle>
          <EmptyDescription>
            Start by creating a section, like Baking or Weeknight dinners.
          </EmptyDescription>
        </>
      )}
    </EmptyHeader>
    {!hasSections && (
      <EmptyContent>
        <NewSectionButton client:load />
      </EmptyContent>
    )}
  </Empty>
</AppLayout>
