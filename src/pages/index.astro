---
import { IconPlus } from "@tabler/icons-react"

import { CookProgress } from "@/components/cook-progress"
import { MannaMark } from "@/components/manna-mark"
import { NewSectionButton } from "@/components/section-dialog"
import { cn } from "cn"

import { buttonVariants } from "@/components/ui/button"
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty"
import AppLayout from "@/layouts/app.astro"
import { getDatabase } from "@/server/database"
import {
  listRecentlyAdded,
  listRecentlyViewed,
  listSections,
} from "@/server/library"

const db = getDatabase()
const hasSections = listSections(db).length > 0
// One big tile for the last recipe opened, then up to four small ones.
const [lastViewed, ...viewed] = listRecentlyViewed(db, 5)
const added = listRecentlyAdded(db, 6)
---

<AppLayout>
  {hasSections && (
    <a
      slot="actions"
      href="/recipes/new"
      class={cn(buttonVariants({ variant: "default" }))}
    >
      <IconPlus />
      New recipe
    </a>
  )}
  {added.length > 0 && (
    <div
      slot="hero"
      class="mx-auto w-full max-w-5xl px-5 pt-2 pb-8 md:px-10 md:pt-6 md:pb-10"
    >
      <h1 class="type-display text-5xl leading-none md:text-7xl">
        What's cooking?
      </h1>
    </div>
  )}
  {added.length > 0 ? (
    <div class="@container mx-auto flex w-full max-w-5xl flex-col gap-10 px-5 pt-6 pb-16 md:px-10 md:pt-0">
      {lastViewed && (
        <section class="flex flex-col gap-3">
          <h2 class="font-semibold">Recently viewed</h2>
          <div class="grid grid-cols-2 gap-3 @3xl:auto-rows-[9rem] @3xl:grid-cols-4">
            <div
              data-hue={lastViewed.sectionColor}
              class="relative col-span-2 flex min-h-44 flex-col justify-between gap-6 rounded-3xl bg-secondary p-5 text-secondary-foreground @3xl:row-span-2 @3xl:p-7"
            >
              <p class="flex items-center gap-2 text-sm font-semibold">
                <span class="size-2 rounded-full bg-swatch" />
                {lastViewed.sectionName}
              </p>
              <a
                href={`/recipes/${lastViewed.id}`}
                class="type-display text-4xl leading-[0.95] text-balance after:absolute after:inset-0 after:rounded-3xl @3xl:text-6xl"
              >
                {lastViewed.title}
              </a>
              <CookProgress
                client:load
                recipeId={lastViewed.id}
                stepCount={lastViewed.stepCount}
              />
            </div>
            {viewed.map((recipe) => (
              <a
                href={`/recipes/${recipe.id}`}
                data-hue={recipe.sectionColor}
                class="flex min-h-28 flex-col justify-between gap-4 rounded-3xl bg-secondary p-4 text-secondary-foreground transition-transform hover:-translate-y-0.5 @3xl:p-5"
              >
                <span class="flex min-w-0 items-center gap-2 text-sm font-semibold">
                  <span class="size-2 shrink-0 rounded-full bg-swatch" />
                  <span class="truncate">{recipe.sectionName}</span>
                </span>
                <span class="line-clamp-2 text-xl leading-tight font-semibold tracking-tight">
                  {recipe.title}
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
      <section class="flex flex-col gap-3">
        <h2 class="font-semibold">Recently added</h2>
        <ul class="grid gap-x-10 @3xl:grid-cols-2">
          {added.map((recipe) => (
            <li class="border-t">
              <a
                href={`/recipes/${recipe.id}`}
                class="flex h-13 items-center gap-3 font-semibold hover:underline hover:underline-offset-4"
              >
                <span
                  data-hue={recipe.sectionColor}
                  class="size-2 shrink-0 rounded-full bg-swatch"
                />
                <span class="truncate">{recipe.title}</span>
                <span class="ml-auto shrink-0 text-sm font-normal text-muted-foreground">
                  {recipe.sectionName}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  ) : (
    <Empty className="flex-1">
      <EmptyHeader>
        <EmptyMedia variant="icon">
          <MannaMark />
        </EmptyMedia>
        <EmptyTitle>No recipes yet</EmptyTitle>
        <EmptyDescription>
          {hasSections
            ? "Add your first recipe, or import one from a link."
            : "Start by creating a section, like Baking or Weeknight dinners."}
        </EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        {hasSections ? (
          <a href="/recipes/new" class={cn(buttonVariants())}>
            <IconPlus />
            New recipe
          </a>
        ) : (
          <NewSectionButton client:load />
        )}
      </EmptyContent>
    </Empty>
  )}
</AppLayout>
