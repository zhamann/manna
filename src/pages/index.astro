---
import { IconPlus } from "@tabler/icons-react"

import { MannaMark } from "@/components/manna-mark"
import { RecipeList } from "@/components/recipe-list"
import { NewSectionButton } from "@/components/section-dialog"
import { cn } from "cn"

import { buttonVariants } from "@/components/ui/button"
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty"
import AppLayout from "@/layouts/app.astro"
import { getDatabase } from "@/server/database"
import {
  listRecentlyAdded,
  listRecentlyViewed,
  listSections,
} from "@/server/library"

const RECENT_LIMIT = 6

const db = getDatabase()
const hasSections = listSections(db).length > 0
const lists = [
  { title: "Recently viewed", recipes: listRecentlyViewed(db, RECENT_LIMIT) },
  { title: "Recently added", recipes: listRecentlyAdded(db, RECENT_LIMIT) },
].filter((list) => list.recipes.length > 0)
---

<AppLayout breadcrumb={["Recipes"]}>
  {lists.length > 0 ? (
    <div class="@container mx-auto flex w-full max-w-5xl flex-col gap-8 p-4 md:p-8">
      <h1 class="font-heading text-4xl leading-tight md:text-5xl">
        What's cooking?
      </h1>
      <div class="grid gap-8 @3xl:grid-cols-2">
        {lists.map((list) => (
          <RecipeList title={list.title} recipes={list.recipes} />
        ))}
      </div>
    </div>
  ) : (
    <Empty className="flex-1">
      <EmptyHeader>
        <EmptyMedia variant="icon">
          <MannaMark />
        </EmptyMedia>
        {hasSections ? (
          <>
            <EmptyTitle>No recipes yet</EmptyTitle>
            <EmptyDescription>
              Add your first recipe, or import one from a link.
            </EmptyDescription>
          </>
        ) : (
          <>
            <EmptyTitle>No recipes yet</EmptyTitle>
            <EmptyDescription>
              Start by creating a section, like Baking or Weeknight dinners.
            </EmptyDescription>
          </>
        )}
      </EmptyHeader>
      <EmptyContent>
        {hasSections ? (
          <a href="/recipes/new" class={cn(buttonVariants())}>
            <IconPlus />
            New recipe
          </a>
        ) : (
          <NewSectionButton client:load />
        )}
      </EmptyContent>
    </Empty>
  )}
</AppLayout>
