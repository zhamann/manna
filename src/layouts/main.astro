---
import "@/styles/global.css"
import { APP_HUE, type Hue } from "@/lib/hues"
import { parseTheme, THEME_COOKIE } from "@/lib/theme"

interface Props {
  title?: string
  /** The page's color: its section's, or Manna's own by default. */
  hue?: Hue
  /** Cook mode: always dark, over the hue's gradient. */
  cook?: boolean
}

const { title, hue = APP_HUE, cook = false } = Astro.props
const theme = cook ? "dark" : parseTheme(Astro.cookies.get(THEME_COOKIE)?.value)
---

<html
  lang="en"
  data-theme={theme}
  data-hue={hue}
  data-cook={cook ? "" : undefined}
  class:list={{ dark: theme === "dark" }}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Manna" />
    <title>{title ? `${title} · Manna` : "Manna"}</title>
    <script is:inline>
      // Apply the picked theme, following the device's setting for "system".
      const deviceDark = matchMedia("(prefers-color-scheme: dark)")
      const applyTheme = () => {
        const root = document.documentElement
        const theme = root.dataset.theme
        root.classList.toggle(
          "dark",
          theme === "dark" || (theme === "system" && deviceDark.matches)
        )
      }
      applyTheme()
      deviceDark.addEventListener("change", applyTheme)
      addEventListener("themechange", applyTheme)
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
